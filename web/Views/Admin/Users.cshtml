@model List<AdminUserRow>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<h1 class="h3 mb-3">Kullanıcılar</h1>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<table class="table table-striped table-sm align-middle">
    <thead>
        <tr>
            <th>Kullanıcı Id</th>
            <th>E-posta</th>
            <th>Roller</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.Id</td>
                <td>@row.Email</td>
                <td>@row.Roles</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="3" class="text-muted">Kullanıcı bulunamadı.</td></tr>
        }
    </tbody>
</table>
